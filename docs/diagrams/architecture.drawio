<mxfile host="FaceCraft"><diagram name="Architecture"><mxGraphModel dx="1880" dy="800" grid="1" gridSize="10" page="1" pageWidth="1880" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;FaceCraft — Deliverable 2 architecture&lt;/b&gt;: text-to-face data pipeline, judge and GAN baseline" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1840" height="36" as="geometry"/></mxCell><mxCell id="n3" value="1. DATA SOURCES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fbfbfb;strokeColor=#b0b0b0;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="260" height="640" as="geometry"/></mxCell><mxCell id="n4" value="2. PRE-PROCESSING  (data/)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fbfbfb;strokeColor=#b0b0b0;dashed=0;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="330" height="640" as="geometry"/></mxCell><mxCell id="n5" value="3. MODELS — all trained from scratch  (models/, training/)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fbfbfb;strokeColor=#b0b0b0;dashed=0;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="560" height="640" as="geometry"/></mxCell><mxCell id="n6" value="GAN baseline" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fff8ef;strokeColor=#d79b00;dashed=0;" vertex="1" parent="1"><mxGeometry x="940" y="240" width="520" height="445" as="geometry"/></mxCell><mxCell id="n7" value="4. EVALUATION &amp; RESULTS  (evaluation/)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fbfbfb;strokeColor=#b0b0b0;dashed=0;" vertex="1" parent="1"><mxGeometry x="1520" y="60" width="340" height="640" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;CelebA&lt;/b&gt;&lt;br&gt;202,599 face photos&lt;br&gt;40 yes/no attributes&lt;br&gt;official train/val/test split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;CelebA-Dialog&lt;/b&gt;&lt;br&gt;0–5 levels: bangs, glasses,&lt;br&gt;beard, smile, age" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="220" height="95" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Face2Text v2.1&lt;/b&gt;&lt;br&gt;18,690 descriptions&lt;br&gt;written by people" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="220" height="95" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Image pipeline&lt;/b&gt;&lt;br&gt;crop 140×140 → 64×64&lt;br&gt;scale to [-1, 1], random flip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="95" width="290" height="85" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Image cache&lt;/b&gt;&lt;br&gt;2.5 GB uint8 array, memory-mapped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="205" width="290" height="60" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Caption engine&lt;/b&gt;&lt;br&gt;template · Dialog degrees · human&lt;br&gt;new random caption every time&lt;br&gt;rules: never contradictory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="290" height="105" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Tokenizer&lt;/b&gt;&lt;br&gt;CLIP BPE vocabulary → 77 ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="435" width="290" height="60" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Held-out pairs (compositional test)&lt;/b&gt;&lt;br&gt;3 attribute pairs removed from training" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="530" width="290" height="75" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;FaceCraftDataset&lt;/b&gt;&lt;br&gt;(image, token ids,&lt;br&gt;40 attributes, source)&lt;br&gt;&lt;br&gt;155,309 training items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="200" height="165" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Attribute classifier — 'the judge'&lt;/b&gt;&lt;br&gt;ResNet-18, 40 outputs&lt;br&gt;used ONLY to check generated faces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="300" height="100" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Text encoder&lt;/b&gt;&lt;br&gt;Transformer (4 layers)&lt;br&gt;→ sentence vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Random noise z&lt;/b&gt;&lt;br&gt;(128 numbers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="200" height="60" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Generator (the forger)&lt;/b&gt;&lt;br&gt;conditional BatchNorm&lt;br&gt;4 × upsample → 64×64 face" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="290" width="210" height="100" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Discriminator (the detective)&lt;/b&gt;&lt;br&gt;spectral norm + projection&lt;br&gt;real &amp;amp; matching caption?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="470" width="210" height="100" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Training rule&lt;/b&gt;&lt;br&gt;hinge loss: real ✓ · fake ✗&lt;br&gt;wrong caption ✗&lt;br&gt;5 D steps per G step · EMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="200" height="110" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Attribute accuracy&lt;/b&gt;&lt;br&gt;does the face have what&lt;br&gt;the prompt asked for?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="100" width="300" height="90" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;FID / KID (realism)&lt;/b&gt;&lt;br&gt;InceptionV3 features,&lt;br&gt;5,000 generated vs real test faces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="230" width="300" height="90" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Results — Deliverable 2&lt;/b&gt;&lt;br&gt;Classifier: 91.5 % (baseline 79.9 %)&lt;br&gt;GAN: FID 48.7 · KID 0.037&lt;br&gt;follows gender, hair, smile, beard;&lt;br&gt;misses glasses, bald, gray hair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="370" width="300" height="140" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Next — Deliverable 3&lt;/b&gt;&lt;br&gt;Diffusion U-Net + cross-attention&lt;br&gt;+ classifier-free guidance&lt;br&gt;→ compared against the GAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1540" y="570" width="300" height="110" as="geometry"/></mxCell><mxCell id="n27" value="pixels" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="labels" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="" style="endArrow=block;endFill=1;html=1;stro